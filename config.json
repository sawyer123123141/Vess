{
  "persona": "friendly",
  "personas": {
    "friendly": "Warm, casual, a bit playful. Two sentences max.",
    "concise": "Terse. Answer and stop. Usually one sentence.",
    "dry": "Understated, mildly sardonic. Never enthusiastic."
  },
  "llm": {
    "model": "qwen2.5:7b",
    "context": 4096,
    "num_predict": 80,
    "keep_alive": -1
  },
  "memory": {
    "short_term_minutes": 10,
    "short_term_turns": 8
  },
  "vision": {
    "model": "llava:7b",
    "max_frame_px": 512
  },
  "whisper": {
    "model": "small",
    "device": "cpu",
    "compute_type": "int8",
    "language": "en",
    "beam_size": 1,
    "condition_on_previous_text": false,
    "vad_filter": true
  },
  "audio": {
    "device": null,
    "sample_rate": 16000,
    "channels": 1,
    "vad_threshold": 0.015,
    "min_utterance_seconds": 0.25,
    "silence_seconds": 0.45,
    "max_utterance_seconds": 15.0,
    "pre_roll_seconds": 0.25,
    "conversation_timeout_seconds": 30.0,
    "wake_variants": ["hey vess", "hey best", "hey guess", "heaviest"],
    "wake_max_distance": 2
  },
  "voice": {
    "engine": "kokoro",
    "name": "af_heart",
    "sample_rate": 24000,
    "chatterbox": {
      "device": "cuda",
      "reference_audio": ""
    }
  },
  "camera": {
    "source": "image",
    "index": 0,
    "path": "test.jpg",
    "mirror": true,
    "max_frame_px": 512
  },
  "detector": {
    "model": "yolo11n.pt",
    "fps": 3,
    "confidence": 0.4
  },
  "display": {
    "width": 64,
    "height": 64,
    "preview_scale": 8,
    "cv2_enabled": false,
    "panel_enabled": false,
    "panel_host": ""
  },
  "triggers": {
    "min_absence_hours": 4,
    "cooldown_minutes": 60,
    "quiet_after_hour": 22,
    "quiet_before_hour": 8
  },
  "apps": {
    "browser": "",
    "spotify": "",
    "unity": "",
    "discord": "",
    "vscode": ""
  },
  "web": {
    "enabled": true,
    "port": 8080,
    "open_browser_on_start": true
  }
}
